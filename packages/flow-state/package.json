{
  "name": "flow-state",
  "version": "0.1.0-alpha.0",
  "description": "An Effect-native runtime for cached resources, workflows, deterministic testing, and inspection.",
  "keywords": [
    "effect",
    "react",
    "state-machine",
    "state-management",
    "typescript"
  ],
  "homepage": "https://github.com/heyitsarpit/flow-state#readme",
  "bugs": {
    "url": "https://github.com/heyitsarpit/flow-state/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyitsarpit/flow-state.git",
    "directory": "packages/flow-state"
  },
  "bin": {
    "flow-state": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react-entry.d.mts",
      "import": "./dist/react-entry.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.mts",
      "import": "./dist/inspect.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nub run check:cli-source-types && nub run check:vnext && vp pack --logLevel warn --no-report src/index.ts src/react-entry.ts src/testing.ts src/server.ts src/inspect.ts && nub run prepare:build-output && nub run check:build-output",
    "check:build-output": "node ./scripts/check-build-output.mjs",
    "check:packed-consumers": "node ./scripts/check-packed-consumers.mjs",
    "check:cli-source-types": "nubx tsc -p tsconfig.json --noEmit",
    "check:typescript-mode-proofs": "node ./scripts/check-typescript-mode-proofs.mjs",
    "check:vnext": "nub run check:vnext-declarations && nub run check:vnext-type-performance",
    "check:vnext-declarations": "node ./scripts/check-vnext-declarations.mjs",
    "check:vnext-type-performance": "node ./scripts/check-vnext-type-performance.mjs",
    "inspect:local-proof": "node ./scripts/inspect-local-proof.mjs",
    "pack": "nub run check:cli-source-types && vp pack --logLevel warn --no-report src/index.ts src/react-entry.ts src/testing.ts src/server.ts src/inspect.ts && nub run prepare:build-output && nub run check:build-output",
    "prepare:build-output": "node ./scripts/prepare-build-output.mjs",
    "release:candidate": "node ./scripts/prepare-alpha-release.mjs",
    "test": "cd ../.. && vp test packages/flow-state/src"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.86",
    "@tanstack/store": "0.11.0",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "effect": "4.0.0-beta.86",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.86",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
