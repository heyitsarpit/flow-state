{
  "name": "flow-state-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "nub run build:library",
    "build:library": "nub run --filter flow-state build && nub run --filter flow-state check:packed-consumers",
    "check": "vp check packages/flow-state-rewrite",
    "check:fix": "vp check --fix packages/flow-state-rewrite",
    "check:toolchain": "node ./scripts/check-toolchain.mjs",
    "docs:build": "nub run --filter @flow-state/docs build",
    "docs:dev": "nub run --filter @flow-state/docs dev",
    "docs:preview": "nub run --filter @flow-state/docs preview",
    "fmt": "vp fmt packages/flow-state-rewrite",
    "fmt:check": "vp fmt packages/flow-state-rewrite --check",
    "lint": "vp lint packages/flow-state-rewrite",
    "lint:fix": "vp lint packages/flow-state-rewrite --fix",
    "test": "vp test",
    "verify": "nub run check:toolchain && nub run check && nub run test && nub run build && nub run docs:build",
    "test:coverage": "vp test run packages/flow-state-rewrite --coverage",
    "report:unused": "knip --workspace packages/flow-state-rewrite --no-exit-code"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "effect": "4.0.0-rc.112",
    "happy-dom": "^20.10.6",
    "knip": "6.34.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "nub@0.7.5",
  "allowBuilds": {
    "es5-ext": false,
    "esbuild": false,
    "msgpackr-extract": false,
    "vue-demi": false
  }
}
