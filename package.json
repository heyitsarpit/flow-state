{
  "name": "flow-state-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "nub run build:library && nub run build:examples && nub run check:example-cli",
    "build:examples": "nub run --filter @flow-state/basic-cached-posts build && nub run --filter @flow-state/optimistic-transactions build && nub run --filter @flow-state/bounded-infinite-feed build && nub run --filter @flow-state/server-prefetch-hydration build && nub run --filter @flow-state/offline-recovery build && nub run --filter @flow-state/incident-console build",
    "build:library": "nub run --filter flow-state build && nub run --filter flow-state check:typescript-mode-proofs && nub run --filter flow-state check:packed-consumers",
    "browser:install": "nub run --filter @flow-state/incident-console browser:install",
    "check": "vp check",
    "check:example-cli": "node ./scripts/check-example-cli-acceptance.mjs",
    "check:fix": "vp check --fix",
    "dev": "nub run --filter @flow-state/incident-console dev",
    "docs:build": "nub run --filter @flow-state/docs build",
    "docs:dev": "nub run --filter @flow-state/docs dev",
    "docs:preview": "nub run --filter @flow-state/docs preview",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "format": "nub run fmt",
    "format:check": "nub run fmt:check",
    "lint": "nub run lint:prepare && vp lint",
    "lint:fix": "vp lint --fix",
    "lint:prepare": "nub run --filter flow-state build",
    "check:lint-build-resolution": "node ./scripts/check-lint-build-resolution.mjs",
    "pack": "nub run --filter flow-state pack",
    "test": "vp test",
    "test:browser": "nub run --filter @flow-state/incident-console test:browser",
    "test:browser:headed": "nub run --filter @flow-state/incident-console test:browser:headed",
    "verify": "nub run check && nub run test && nub run build && nub run test:browser && nub run docs:build"
  },
  "devDependencies": {
    "@types/node": "latest",
    "happy-dom": "^20.10.6",
    "typescript": "6.0.3",
    "vite-plus": "0.2.1",
    "vitest": "4.1.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "nub@0.7.5",
  "allowBuilds": {
    "es5-ext": false,
    "esbuild": false,
    "msgpackr-extract": false,
    "vue-demi": false
  }
}
